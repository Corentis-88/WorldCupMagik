{
  "name": "worldcupmagic",
  "version": "0.1.0",
  "description": "A Windows desktop World Cup betting research toy with odds snapshots, public news scanning, and risk-adjusted betslip ideas.",
  "author": "Super Chris",
  "private": true,
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "app": "electron .",
    "dev": "electron .",
    "daily": "node src/cli.mjs daily",
    "snapshot": "node src/cli.mjs snapshot",
    "analyse": "node src/cli.mjs analyse",
    "offers": "node src/cli.mjs offers",
    "status": "node src/cli.mjs status",
    "web:build-data": "node scripts/build-web-data.mjs",
    "dist:win": "electron-builder --win nsis",
    "test": "node --test tests/**/*.test.mjs"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.superchris.worldcupmagic",
    "productName": "Super Chris's World Cup Betting Engine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "config/**/*",
      "data/bookmaker-offers.json",
      "data/fixtures.json",
      "data/news-articles.json",
      "data/odds-snapshots.json",
      "data/recommendation-runs.json",
      "data/team-intelligence-latest.json",
      "data/intelligence-observations.json",
      "data/team-match-history.json",
      "data/bet-outcomes.json",
      "data/team-stats.json",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Super Chris World Cup"
    }
  }
}
